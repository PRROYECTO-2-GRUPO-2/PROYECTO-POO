from datetime import datetime

class Notificacion:
    def __init__(self, id_notificacion: int, mensaje: str, canal: str):
        self.id = id_notificacion
        self.mensaje = mensaje
        self.fecha_envio = datetime.now()
        self.canal = canal
        self.enviada = False

    def enviar(self):
        """Simula el envío de la notificación."""
        print(f"Enviando notificación #{self.id} por {self.canal}...")
        print(f"Mensaje: {self.mensaje}")
        print(f"Fecha y hora: {self.fecha_envio.strftime('%Y-%m-%d %H:%M')}")
        self.marcar_como_enviada()

    def marcar_como_enviada(self):
        """Actualiza el estado de la notificación a enviada."""
        self.enviada = True
        print(f"Estado: Notificación #{self.id} marcada como enviada ([✓]).\n")

# --- Ejemplo de uso aislado ---
if __name__ == "__main__":
    # Creamos una notificación usando los atributos del diagrama
    notif = Notificacion(
        id_notificacion=1, 
        mensaje="Se ha detectado un nuevo incidente en su zona.", 
        canal="Email"
    )
    
    # Ejecutamos el método para enviar
    notif.enviar()
